#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

# Hardened router shutdown for CraftedWorkflowsOS/router
# Production router: ~/CraftedWorkflowsOS/router/router (10MB, recent build)
# Port: 8643
# Inverse of startr - only stops the verified production router

ROUTER_DIR="$HOME/CraftedWorkflowsOS/router"
ROUTER_BIN="$ROUTER_DIR/router"
PORT=8643
HEALTH_ENDPOINT="http://127.0.0.1:$PORT/health"
LOCK_FILE="$HOME/.router-locks/router-startr.lock"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}$*${NC}"; }
log_warn() { echo -e "${YELLOW}$*${NC}"; }
log_error() { echo -e "${RED}$*${NC}"; }

# Verify production binary identity (same logic as startr)
verify_production_binary() {
    local pid="$1"
    local cwd
    local exe

    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 1
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1

    # ALWAYS require exact production working directory
    [[ "$cwd" == "$ROUTER_DIR" ]] || return 1

    # ALWAYS require exact "./router" command line
    local cmdline
    cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' | sed 's/ $//') || return 1
    [[ "$cmdline" == "./router" ]] || return 1

    # Check executable path: either exact production binary OR legacy deleted Go-build path
    local is_legacy=false
    if [[ "$exe" == "$ROUTER_BIN" ]]; then
        # Exact production binary - verify size directly
        local size
        size=$(stat -c%s "$exe" 2>/dev/null) || return 1
        [[ $size -gt 8000000 ]] || return 1
    elif [[ "$exe" == /data/data/com.termux/files/usr/tmp/go-build*/b001/exe/router* ]]; then
        # Legacy deleted Go-build executable - NARROWLY matched pattern
        # Verify production binary on disk matches expected size
        local size
        size=$(stat -c%s "$ROUTER_BIN" 2>/dev/null) || return 1
        [[ $size -gt 8000000 ]] || return 1
        is_legacy=true
    else
        # Any other executable path is rejected
        return 1
    fi

    # Additional health guard for legacy processes
    if [[ "$is_legacy" == true ]]; then
        # Verify health endpoint returns expected provider structure
        local health
        health=$(curl -sS --max-time 5 "$HEALTH_ENDPOINT" 2>/dev/null) || return 1
        # Check for expected providers: nvidia, zydit-v1, zydit-v2 (compact JSON)
        echo "$health" | grep -q '"name":"nvidia"' || return 1
        echo "$health" | grep -q '"name":"zydit-v1"' || return 1
        echo "$health" | grep -q '"name":"zydit-v2"' || return 1
        # All three must be healthy
        echo "$health" | grep -q '"healthy":true' || return 1
    fi

    return 0
}

# Find production router PID (same logic as startr)
find_production_pid() {
    local pids
    pids=$(pgrep -f '^\./router$' 2>/dev/null) || return 1

    for pid in $pids; do
        if verify_production_binary "$pid"; then
            echo "$pid"
            return 0
        fi
    done
    return 1
}

# Wait for process to exit with timeout
wait_for_exit() {
    local pid="$1"
    local timeout="${2:-10}"  # seconds
    local elapsed=0

    # R2: pure-shell arithmetic (no bc dependency — bc isn't guaranteed on
    # Termux). Poll every 0.5s using integer tenths.
    local tenths=0
    local limit=$((timeout * 2))
    while kill -0 "$pid" 2>/dev/null; do
        if (( tenths >= limit )); then
            return 1
        fi
        sleep 0.5
        tenths=$((tenths + 1))
    done
    return 0
}

# Main logic
main() {
    log_info "Attempting to stop production router..."

    # Acquire lock to prevent concurrent startr/stopr operations
    # Use a different fd to avoid conflict with startr's fd 9
    exec 8>"$LOCK_FILE"
    if ! flock -n 8; then
        log_warn "Another startr/stopr invocation is running. Waiting for lock..."
        # Wait for lock with timeout
        local lock_wait=0
        while ! flock -n 8 2>/dev/null; do
            sleep 0.5
            lock_wait=$((lock_wait + 1))
            if [[ $lock_wait -gt 30 ]]; then
                log_error "Timeout waiting for lock. Another operation may be stuck."
                exit 2
            fi
        done
    fi

    # Find production router PID
    local pid
    pid=$(find_production_pid) || pid=""

    if [[ -z "$pid" ]]; then
        log_info "No production router process found."

        # Check if port is still occupied (shouldn't happen if no PID)
        if python3 -c "
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(1)
try:
    s.connect(('127.0.0.1', $PORT))
    s.close()
    print('occupied')
except:
    print('free')
" | grep -q occupied; then
            log_warn "Port $PORT is still occupied but no production router PID found."
            log_warn "This may indicate an unrelated process. Manual investigation required."
        fi

        # Do not remove the lock merely because no production PID was found.
        # The lock may belong to a concurrent startr/stopr operation.
        log_info "Router already stopped. Existing lock left untouched for safety."
        exit 0
    fi

    log_info "Found production router (PID: $pid)"

    # Verify it's actually our production router one more time
    if ! verify_production_binary "$pid"; then
        log_error "PID $pid no longer matches production router identity. Aborting."
        exit 3
    fi

    # Check if process is responsive via health endpoint
    if curl -sS --max-time 3 "$HEALTH_ENDPOINT" >/dev/null 2>&1; then
        log_info "Router is responding to health checks."
    else
        log_warn "Router process exists but health endpoint is not responding."
    fi

    # Graceful shutdown: SIGTERM
    log_info "Sending SIGTERM to PID $pid..."
    if ! kill -TERM "$pid" 2>/dev/null; then
        log_error "Failed to send SIGTERM to PID $pid. Process may have already exited."
        # Verify it's gone
        if kill -0 "$pid" 2>/dev/null; then
            log_error "Process still exists but kill failed. Permission issue?"
            exit 4
        else
            log_info "Process already gone."
        fi
    else
        # Wait for graceful exit
        log_info "Waiting for graceful shutdown (10s timeout)..."
        if wait_for_exit "$pid" 10; then
            log_info "Router stopped gracefully."
        else
            log_warn "Router did not exit within 10s after SIGTERM."
            log_warn "Process $pid still running. Manual intervention required."
            log_warn "To force kill: kill -KILL $pid"
            exit 5
        fi
    fi

    # Verify port is free
    sleep 0.5
    if python3 -c "
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(1)
try:
    s.connect(('127.0.0.1', $PORT))
    s.close()
    print('occupied')
except:
    print('free')
" | grep -q occupied; then
        log_warn "Port $PORT still appears occupied after shutdown."
        log_warn "This may indicate another process or TIME_WAIT state."
    else
        log_info "Port $PORT is free."
    fi

    # Clean up lock file — plain guarded rm: it's a known path under
    # $HOME/.router-locks/, never a user file.
    if [[ -f "$LOCK_FILE" ]]; then
        log_info "Removing lock file..."
        rm -f "$LOCK_FILE"
    fi

    log_info "Production router shutdown complete."
    exit 0
}

main "$@"
